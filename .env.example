# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb+srv://... or mongodb://127.0.0.1:27017/nestlink).
# When unset, NestLink automatically uses its persistent local file-backed database so preview works out of the box.
MONGODB_URI=

# ADMIN_PASSCODE: Optional server-side administrator passcode.
# When unset, the first administrator can claim access using the inline Admin Setup form on the Login page.
ADMIN_PASSCODE=
